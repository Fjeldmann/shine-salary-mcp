{
  "name": "shine-salary-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local, read-only MCP server for Shine Salary (api.salary.dk)",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "shine-salary-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm test",
    "smoke:live": "node --env-file=.env dist/dev/live-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
